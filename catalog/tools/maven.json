{
  "id": "maven",
  "label": "Java / Kotlin (Maven)",
  "priority": 50,
  "detect": { "files": ["pom.xml"] },
  "test": { "rule": "fixed", "value": "mvn test" },
  "mutation": {
    "rule": "fixed",
    "value": {
      "tool": "pit",
      "command": "mvn org.pitest:pitest-maven:mutationCoverage",
      "report": "target/pit-reports/**/mutations.xml",
      "format": "pit",
      "install": "",
      "scopeFlag": ""
    }
  }
}

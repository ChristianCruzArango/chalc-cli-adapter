{
  "id": "python",
  "label": "Python",
  "priority": 40,
  "detect": {
    "files": [
      "pyproject.toml",
      "setup.cfg",
      "requirements.txt"
    ]
  },
  "signals": {
    "python": [
      "pyproject.toml",
      "setup.cfg",
      "requirements.txt"
    ]
  },
  "test": {
    "rule": "bySignal",
    "signal": "python",
    "cases": [
      {
        "match": "pytest",
        "value": "pytest"
      }
    ],
    "default": ""
  },
  "mutation": {
    "rule": "bySignal",
    "signal": "python",
    "cases": [
      {
        "match": "pytest",
        "value": {
          "tool": "mutmut",
          "command": "mutmut run; mutmut export-cicd-stats",
          "report": "mutants/mutmut-cicd-stats.json",
          "format": "mutmut-stats",
          "install": "uv add --dev 'mutmut>=3.2'",
          "scopeFlag": "",
          "setup": "**mutmut 3 has no `junitxml`.** The run ends with `mutmut export-cicd-stats`, which writes the counts to `{report}`.\nThose counts carry no file or line, so the score covers everything mutmut mutated and a failing run shows one aggregated finding.\nmutmut 3 mutates a copy under `mutants/`, so stopping a run never leaves your sources mutated."
        }
      }
    ]
  }
}

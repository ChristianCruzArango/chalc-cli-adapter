{
  "name": "chalc",
  "version": "0.1.0",
  "description": "CLI local para crear y equipar proyectos con skills, MCP, reglas, SDD, specs y QA agent; IA opcional y provider-agnóstica.",
  "license": "MIT",
  "author": "Christian Alexis Cruz Arango <christiancruzarango@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianCruzArango/chalc-cli-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/ChristianCruzArango/chalc-cli-adapter/issues"
  },
  "homepage": "https://github.com/ChristianCruzArango/chalc-cli-adapter#readme",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "mcp",
    "sdd",
    "skills"
  ],
  "bin": {
    "chalc": "bin/chalc.mjs",
    "chalc-cli": "cli/index.mjs"
  },
  "files": [
    "bin/",
    "catalog/",
    "cli/",
    "lib/",
    "rules/",
    "targets/",
    "README.md",
    "README.es.md",
    "skills-lock.json"
  ],
  "scripts": {
    "start": "node bin/chalc.mjs",
    "lang": "node bin/chalc.mjs lang",
    "init": "node bin/chalc.mjs init",
    "inspect": "node bin/chalc.mjs inspect",
    "doctor": "node bin/chalc.mjs doctor",
    "configure": "node bin/chalc.mjs configure",
    "spec": "node bin/chalc.mjs spec",
    "config-ia": "node bin/chalc.mjs config-ia",
    "ai-doctor": "node bin/chalc.mjs ai-doctor",
    "eval-ia": "node bin/chalc.mjs eval-ia",
    "spec-ia": "node bin/chalc.mjs spec-ia",
    "cli": "node cli/index.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run doctor -- --yes && npm run eval-ia && npm run pack:check",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
